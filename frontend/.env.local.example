# Wandr — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Travel Guide badge — set to "false" to hide the badge and the Guide tab.
# Any other value (or omitting it entirely) leaves the feature enabled.
NEXT_PUBLIC_ENABLE_TRAVEL_GUIDE_BADGE=true
