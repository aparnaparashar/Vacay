# Wandr — Backend Environment Variables
# Copy this file to .env and fill in your keys.

# ── AI ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Maps / Places ─────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OLA_MAPS_API_KEY=your_ola_maps_api_key_here

# ── Flights / Hotels ──────────────────────────────────────────────
SERPAPI_API_KEY=your_serpapi_key_here
DUFFEL_API_KEY=your_duffel_api_key_here

# ── Travel Guide (TuGo + Travel Risk Intelligence) ────────────────
# TuGo: register at https://developer.tugo.com
TUGO_API_KEY=your_tugo_api_key_here
TUGO_API_BASE_URL=https://api.tugo.com/v1/travelsafe/countries
# Travel Risk Intelligence: free key at https://travelriskapi.com (100 req/day)
# Demo key for local development only: demo-key-travel-risk-2026
TRAVEL_RISK_API_KEY=your_travelrisk_api_key_here
TRAVEL_RISK_API_BASE_URL=https://travelriskapi.com/api/v1
# Merged results are cached per ISO country code for this many hours.
TRAVEL_GUIDE_CACHE_TTL_HOURS=12

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vacay:vacay_password@localhost:5432/vacay_db

# ── Auth (Clerk) ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Wandr Travel <onboarding@resend.dev>

# ── File storage (Cloudflare R2 / S3) ─────────────────────────────
R2_BUCKET_NAME=wandr
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ── CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
