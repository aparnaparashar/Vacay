# POSTGRES (e.g. Neon connection details)
PG_HOST=ep-example-host.us-east-2.aws.neon.tech
PG_PORT=5432
PG_USER=your_neon_user
PG_PASSWORD=your_neon_password
PG_DATABASE=your_neon_db_name

# NEO4J (Local via Docker Compose)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# REDIS (Local via Docker Compose)
REDIS_URL=redis://localhost:6379

# GITHUB APP
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...-----END RSA PRIVATE KEY-----\n"
